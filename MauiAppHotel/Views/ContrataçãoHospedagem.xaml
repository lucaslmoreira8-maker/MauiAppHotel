<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.ContrataçãoHospedagem"
             Title="ContrataçãoHospedagem"
             NavigationPage.HasNavigationBar = "False"
             BackgroundColor="{StaticResource Gray100}"
            >

    <VerticalStackLayout VerticalOptions="CenterAndExpand"
                         Padding="65">
        <Label 
            Text="Calculo da Diária"
            FontFamily="Redaction10Bold"
            FontSize="50"
            TextColor="{StaticResource Gray600}"
            HorizontalOptions="Center"
            HorizontalTextAlignment="Center"
             />
        <Frame Padding="10">
            <VerticalStackLayout>
                <Grid RowDefinitions="Auto, Auto"
                      ColumnDefinitions="*, *, *">

                    <Label Grid.Row="0" Grid.Column="0"
                          Text="Adulto"/>

                    <Label Grid.Row="0" Grid.Column="1"
                            TextColor="{StaticResource Gray400}"
                            Text="{Binding Value}"
                            BindingContext="{x:Reference stp_adultos}"/>

                    <Stepper Grid.Row="0" Grid.Column="2"
                             x:Name="stp_adultos"
                             Minimum="0"
                             Maximum="10"
                             Increment="1"/>

                    <Label Grid.Row="1" Grid.Column="0"
                          Text="Crianças"/>

                    <Label Grid.Row="1" Grid.Column="1"
                            TextColor="{StaticResource Gray400}"
                            Text="{Binding Value}"
                            BindingContext="{x:Reference stp_criancas}"/>

                    <Stepper Grid.Row="1" Grid.Column="2"
                             x:Name="stp_criancas"
                             Minimum="0"
                             Maximum="10"
                             Increment="1"/>

                </Grid>
                <Label Text="Escolha sua Suite"/>

                <Picker x:Name="pck_quarto"
                        ItemDisplayBinding="{Binding Descricao}"/>

                <Frame Padding="10" Margin="10">
                    <VerticalStackLayout>
                        <Label Text="Periódo de estadia"/>

                        <HorizontalStackLayout>
                            <Label Text="Check-in"/>

                            <DatePicker x:Name="dtpck_checkin"
                                        DateSelected="dtpck_checkin_DateSelected"
                                        Format="dd/MM/yyyy"/>
                        </HorizontalStackLayout>

                        <HorizontalStackLayout>
                            <Label Text="Check-out"/>

                            <DatePicker x:Name="dtpck_check_out"
                                        Format="dd/MM/yyyy"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Frame>
                <Button Text="Avançar"
                        Background="{StaticResource Gray400}"
                        Clicked="Button_Clicked"/>
            </VerticalStackLayout>
        </Frame>
        <Button Text="Sobre o App" 
        Clicked="OnSobreClicked" 
        HorizontalOptions="Center"
                Background="{StaticResource Gray400}"/>
    </VerticalStackLayout>
</ContentPage>